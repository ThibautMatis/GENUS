# Clé API Anthropic (sans clé, l'application génère un CR "hors-ligne" à partir de modèles de phrases)
ANTHROPIC_API_KEY=
# Modèle utilisé pour la rédaction du CR
GENUS_MODEL=claude-opus-5-5
# Niveau d'effort (low | medium | high) : "low" suffit pour une traduction arbre -> texte et reste rapide
GENUS_EFFORT=low
PORT=8787

# --- CanRisk (calcul de risque BOADICEA) ---
# Compte créé sur https://www.canrisk.org (le serveur demande lui-même un jeton d'accès)
CANRISK_USERNAME=
CANRISK_PASSWORD=
# ou directement un jeton obtenu via https://www.canrisk.org/auth-token/
CANRISK_TOKEN=
# Taux d'incidence utilisés par le modèle (UK par défaut)
CANRISK_CANCER_RATES=UK
